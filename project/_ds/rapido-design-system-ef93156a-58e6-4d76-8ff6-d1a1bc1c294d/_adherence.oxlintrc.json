        "selector": "JSXOpeningElement[name.name='StatusBarBattery'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|prop|darkMode|charge|percentage|charging|key|ref|className|style|children)$/]",
        "message": "<StatusBarBattery> doesn't accept that prop. Declared props: className, style, prop, darkMode, charge, percentage, charging."
