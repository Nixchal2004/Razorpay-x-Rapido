{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/buttons/**",
              "components/cards/**",
              "components/chrome/**",
              "components/forms/**",
              "components/lists/**",
              "components/messaging/**",
              "components/navigation/**",
              "ui_kits/rider-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeCancelled'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|status|text1|key|ref|className|style|children)$/]",
        "message": "<BadgeCancelled> doesn't accept that prop. Declared props: className, style, status, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeCompleted'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|status|text1|key|ref|className|style|children)$/]",
        "message": "<BadgeCompleted> doesn't accept that prop. Declared props: className, style, status, text1."
      },
      {
