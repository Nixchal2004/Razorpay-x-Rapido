        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute[name.name='dynIslSize'] > Literal[value!=/^(?:default|separated|lg|xl|ultra|n\\/a)$/]",
        "message": "<StatusBar> dynIslSize must be one of 'default' | 'separated' | 'lg' | 'xl' | 'ultra' | 'n/a'."
      },
